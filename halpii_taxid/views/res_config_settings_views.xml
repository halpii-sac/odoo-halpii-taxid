<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.halpii_taxid</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Tax ID Validation" string="Tax ID Validation" name="halpii_taxid"
                     logo="/halpii_taxid/static/description/icon.png">
                    <block title="HALPII Tax ID" name="halpii_taxid_block">
                        <setting id="halpii_taxid_api_key" string="API key"
                                 help="Validates tax IDs in 130+ countries and territories with taxid.halpii.com.">
                            <field name="halpii_taxid_api_key" password="True" placeholder="Paste your key"/>
                            <div class="text-muted mt-2">
                                No key yet? Create one at no cost at
                                <a href="https://taxid.halpii.com" target="_blank">taxid.halpii.com</a>.
                                Each validation is one lookup; a no-cost key includes 100 lookups a month.
                            </div>
                        </setting>
                        <setting id="halpii_taxid_validate_on_save" string="Validate on save"
                                 help="Validate automatically when a company or individual is created, or when its tax ID or country changes.">
                            <field name="halpii_taxid_validate_on_save"/>
                        </setting>
                        <setting id="halpii_taxid_block_on_fail" string="Block when the verdict is fail"
                                 help="Off: the contact is saved and flagged in red. On: saving a tax ID with verdict fail is refused. If the service cannot be reached the contact is always saved."
                                 invisible="not halpii_taxid_validate_on_save">
                            <field name="halpii_taxid_block_on_fail"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
